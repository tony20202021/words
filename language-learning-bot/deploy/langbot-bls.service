[Unit]
Description=Language Learning Bot — Business Logic Service
After=network.target langbot-backend.service

[Service]
Type=simple
User=tony
WorkingDirectory=/home/tony/repos/words/language-learning-bot/business_logic_service
Environment="BACKEND_URL=http://localhost:8500"
Environment="TELEGRAM_BOT_TOKEN="
EnvironmentFile=-/home/tony/repos/words/language-learning-bot/deploy/.env
ExecStart=/home/tony/miniconda3/envs/amikhalev_language_learning_bot/bin/uvicorn \
    app.main:app --host 0.0.0.0 --port 8700
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
