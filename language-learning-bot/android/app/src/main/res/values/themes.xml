<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LangBot" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorPrimaryVariant">#0D47A1</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#0d6efd</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">#F8F9FA</item>
    </style>
    <!-- Переход в увеличение и обратно: рост из середины и уменьшение назад.
         Нужен обоим увеличениям — карточки слова и графика: без него момент
         перехода терялся, экран просто подменялся. -->
    <style name="ZoomDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/zoom_enter</item>
        <item name="android:windowExitAnimation">@anim/zoom_exit</item>
    </style>
</resources>
