<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:titleTextColor="@android:color/white" />

    <!-- Плашка соединения лежит ПОВЕРХ карточки, а не в потоке.
         Жалоба владельца: встроенная в столбец, она сдвигала всё вниз, и по
         нижней части экрана это читалось как переход к следующему слову —
         приходилось перечитывать, чтобы понять, что ничего не изменилось. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <!-- id нужен увеличению: с этого столбца снимается рисунок всей
                 карточки для полноэкранного просмотра — см. StudyActivity.openCardZoom -->
            <LinearLayout
                android:id="@+id/cardScrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Badge placeholder — hidden; badge is now rendered inside cardContent header row -->
                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Restart recommendation notice (shown above card when error limit reached).
                     Плашка советует перезапустить сессию — и тут же даёт это сделать:
                     раньше совет был, а ход к нему лежал через меню. -->
                <LinearLayout
                    android:id="@+id/restartNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="#FFF3CD"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvRestartNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#856404" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestartNow"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:minHeight="44dp"
                        android:text="🔄 Начать заново"
                        android:textColor="#856404"
                        android:textSize="13sp"
                        app:strokeColor="#856404" />
                </LinearLayout>

                <!-- Stale session notice -->
                <TextView
                    android:id="@+id/tvStaleSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="#CCE5FF"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:textColor="#004085"
                    android:visibility="gone" />

                <!-- Card content area -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:id="@+id/cardContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:minHeight="160dp"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Sounds row (hidden when no sounds) -->
                <LinearLayout
                    android:id="@+id/soundsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <!-- Divider -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp" />

                <!-- Pick mode answer result banner -->
                <TextView
                    android:id="@+id/tvPickResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone" />

                <!-- Study action buttons -->
                <LinearLayout
                    android:id="@+id/buttonRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- "Don't show this combo" ban button — shown after wrong pick-mode answer -->
                <LinearLayout
                    android:id="@+id/banButtonRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <!-- Hint management button (shown only when answer revealed + types enabled) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:text="💡 Подсказки"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <!-- Progress bars — built entirely in code -->
                <LinearLayout
                    android:id="@+id/progressArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Big word display (unused standalone, kept for binding) -->
                <LinearLayout
                    android:id="@+id/bigWordArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <!-- Extra content blocks (radicals, references, tones — one card each) -->
                <LinearLayout
                    android:id="@+id/extraCardsArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/tvConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#FFF3CD"
            android:textColor="#856404"
            android:textSize="13sp"
            android:padding="10dp"
            android:elevation="8dp"
            android:visibility="gone" />

    </FrameLayout>

    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:indeterminate="true"
        android:visibility="gone" />

</LinearLayout>
