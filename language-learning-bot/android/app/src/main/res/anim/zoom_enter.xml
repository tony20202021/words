<?xml version="1.0" encoding="utf-8"?>
<!-- Вход в увеличение: картинка вырастает из середины и проявляется.

     Прежде окно появлялось мгновенно, и момент перехода терялся: человек не
     понимал, открылось увеличение или экран просто сменился. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <scale
        android:fromXScale="0.85" android:toXScale="1.0"
        android:fromYScale="0.85" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="200" />
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="200" />
</set>
