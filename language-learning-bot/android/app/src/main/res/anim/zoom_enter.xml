<?xml version="1.0" encoding="utf-8"?>
<!-- Вход в увеличение: картинка разворачивается из одной точки в середине.

     Сначала было 0.85 за 200 мс — владелец сказал, что вход «вроде видно», а
     возврата не видно вовсе. Потом 0.6; теперь из нуля: движение читается как
     переход, а не как подмена экрана. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <scale
        android:fromXScale="0.0" android:toXScale="1.0"
        android:fromYScale="0.0" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="320" />
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="320" />
</set>
