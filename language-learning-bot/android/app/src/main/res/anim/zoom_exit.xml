<?xml version="1.0" encoding="utf-8"?>
<!-- Возврат: картинка сходится в одну точку в середине.

     Возврат не был виден по двум причинам: движение было мелким и картинку
     стирали в тот же миг, когда начиналось закрытие, — анимация играла на
     пустом окне. Теперь картинка держится до конца (см. ZOOM_EXIT_MS). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_interpolator">
    <scale
        android:fromXScale="1.0" android:toXScale="0.0"
        android:fromYScale="1.0" android:toYScale="0.0"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="420" />
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="420" />
</set>
