<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LangBotApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.LangBot"
        android:usesCleartextTraffic="true">

        <!--
            Портрет закреплён у всех экранов.

            По умолчанию поворот телефона УНИЧТОЖАЕТ активность и создаёт её
            заново: экран учёбы на этом заново ходил в сеть за сессией из
            onCreate, терял отметку прослушанного варианта в пик-режиме и
            обрывал звук. То есть поворот стоил сетевого запроса.

            Карточка — вертикальная колонка с крупным ивритом и таблицами
            огласовок; в альбомной ориентации по высоте места вдвое меньше, а
            отдельной вёрстки под неё нет.
        -->
        <activity
            android:name=".LoginActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LanguagesActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".StudyActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".StatsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".HintsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".SettingsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".HelpActivity" android:screenOrientation="portrait" android:exported="false" />

    </application>
</manifest>
